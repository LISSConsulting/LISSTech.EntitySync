<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>lisstech-entitysync-mcp</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Version>26.8.0</Version>
    <PackageReadmeFile>..\README.md</PackageReadmeFile>
    <Description>LISSTech EntitySync MCP server for natural-language vendor entity synchronization.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.4.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.29" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Npgsql" Version="8.0.9" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LISSTech.EntitySync.Platform.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\Core\LISSTech.EntitySync.Core.csproj" />
    <ProjectReference Include="..\src\Ports\LISSTech.EntitySync.Ports.csproj" />
    <ProjectReference Include="..\src\Application\LISSTech.EntitySync.Application.csproj" />
    <ProjectReference Include="..\src\Adapters\LISSTech.EntitySync.Adapters.csproj" />
    <ProjectReference Include="..\src\Mapping\LISSTech.EntitySync.Mapping.csproj" />
    <ProjectReference Include="..\src\Matching\LISSTech.EntitySync.Matching.csproj" />
    <ProjectReference Include="..\src\Runtime\LISSTech.EntitySync.Runtime.csproj" />
  </ItemGroup>

</Project>
