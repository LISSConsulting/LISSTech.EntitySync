{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true,
      "timeout": 30000,
    },
    "entitysync": {
      "type": "local",
      "command": ["cmd.exe", "/d", "/c", "%USERPROFILE%\\scoop\\apps\\lisstech-entitysync-mcp\\current\\lisstech-entitysync-mcp.exe"],
      "enabled": true,
      "timeout": 180000,
    },
  },
  "lsp": true,
  "permission": {
    "lsp": "allow",
  },
  "experimental": {
    "mcp_timeout": 180000,
  },
}
