# Copy these names into the deployment secret/configuration store. Required
# deployment-specific identifiers, URLs, passwords, and tokens are intentionally
# empty. Never commit a populated copy.

# Dedicated EntitySync PostgreSQL database. DATABASE_URL must identify
# entitysync-db and must never be the OrchestraMSP database URL.
POSTGRES_DB=entitysync
POSTGRES_USER=entitysync
POSTGRES_PASSWORD=
DATABASE_URL=

# Durable worker tenancy and bounded leasing. Tenant IDs are comma-separated
# Entra tenant UUIDs. Heartbeat must be less than lease.
ENTITYSYNC_TENANT_IDS=
ENTITYSYNC_WORKER_LEASE_SECONDS=60
ENTITYSYNC_WORKER_HEARTBEAT_SECONDS=10
ENTITYSYNC_WORKER_RETRY_SECONDS=5

# Compose fixes this path for both application hosts and mounts one named,
# persistent key ring there. Do not point it at a credential or source mount.
ENTITYSYNC_DATA_PROTECTION_KEY_PATH=/var/lib/entitysync/keys

# Authority is the exact single-tenant v2 issuer. MCP_OAUTH_RESOURCE is the
# canonical absolute HTTPS MCP URL; MCP_OAUTH_AUDIENCE is the token's exact aud.
# The allowlist contains comma-separated OrchestraMSP azp client UUIDs.
MCP_OAUTH_AUTHORITY=
MCP_OAUTH_RESOURCE=
MCP_OAUTH_AUDIENCE=
MCP_OAUTH_SCOPES=EntitySync.Read EntitySync.Operate EntitySync.Approve EntitySync.Manage EntitySync.Audit EntitySync.Expert
MCP_OAUTH_REQUIRED_SCOPE=EntitySync.Read
ENTITYSYNC_OM_WORKLOAD_AZP_ALLOWLIST=

# Optional OAuth metadata hints. Configure all three together only when issuer
# discovery cannot advertise the endpoints and public PKCE client.
MCP_OAUTH_AUTHORIZATION_ENDPOINT=
MCP_OAUTH_TOKEN_ENDPOINT=
MCP_OAUTH_PUBLIC_CLIENT_ID=

# Required production OTLP/HTTP Logfire export. The headers value is secret.
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
MCP_OTEL_SERVICE_NAME=lisstech-entitysync-mcp
SCHEDULER_OTEL_SERVICE_NAME=lisstech-entitysync-scheduler

# Vendor and Orchestra Client Directory credentials are not Compose state.
# Create each authenticated connection through the control API so its versioned
# public configuration and encrypted secret configuration are stored in PostgreSQL.
