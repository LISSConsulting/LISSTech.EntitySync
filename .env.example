# OAuth authorization server issuer and this deployment's canonical MCP URL/audience.
MCP_OAUTH_AUTHORITY=https://auth.example.com
MCP_OAUTH_RESOURCE=https://mcp.example.com/mcp
MCP_OAUTH_AUDIENCE=https://mcp.example.com/mcp
MCP_OAUTH_SCOPES=mcp:tools
MCP_OAUTH_REQUIRED_SCOPE=mcp:tools

# Optional compatibility hints for OAuth clients whose discovery does not support the issuer's metadata layout.
# Configure all three together; the client ID must identify a public PKCE client.
MCP_OAUTH_AUTHORIZATION_ENDPOINT=
MCP_OAUTH_TOKEN_ENDPOINT=
MCP_OAUTH_PUBLIC_CLIENT_ID=

# Required durable PostgreSQL storage for permanent route-scoped exclusions.
# Empty exclusion results are valid; database read failures make create-missing planning/apply fail closed.
DATABASE_URL=Host=entitysync-db;Port=5432;Database=entitysync;Username=entitysync;Password=replace-me
POSTGRES_DB=entitysync
POSTGRES_USER=entitysync
POSTGRES_PASSWORD=replace-me

# Configure only the vendors this deployment uses.
HALO_BASE_URL=
HALO_CLIENT_ID=
HALO_CLIENT_SECRET=
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
NCENTRAL_BASE_URL=
NCENTRAL_USER_API_TOKEN=
NCENTRAL_SERVICE_ORG_ID=
AGENTCONTROLLER_AUTH_BASE_URL=https://api-agent-controller.example.com
AGENTCONTROLLER_ENTRA_TENANT_ID=
AGENTCONTROLLER_ENTRA_CLIENT_ID=
AGENTCONTROLLER_ENTRA_CLIENT_SECRET=
AGENTCONTROLLER_ENTRA_SCOPE=api://agent-controller-application-id/.default
BILLCOM_API_TOKEN=
