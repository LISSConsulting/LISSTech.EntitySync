# OAuth authorization server issuer and this deployment's canonical MCP URL/audience.
MCP_OAUTH_AUTHORITY=https://auth.example.com
MCP_OAUTH_RESOURCE=https://mcp.example.com/mcp
MCP_OAUTH_AUDIENCE=https://mcp.example.com/mcp
MCP_OAUTH_SCOPES=mcp:tools
MCP_OAUTH_REQUIRED_SCOPE=mcp:tools

# Optional compatibility hints for OAuth clients whose discovery does not support the issuer's metadata layout.
# Configure all three together; the client ID must identify a public PKCE client.
MCP_OAUTH_AUTHORIZATION_ENDPOINT=
MCP_OAUTH_TOKEN_ENDPOINT=
MCP_OAUTH_PUBLIC_CLIENT_ID=

# Required durable PostgreSQL storage for vendor record snapshots, relationship edges,
# permanent route-scoped exclusions, and scheduler change-state checkpoints.
DATABASE_URL=Host=entitysync-db;Port=5432;Database=entitysync;Username=entitysync;Password=replace-me
POSTGRES_DB=entitysync
POSTGRES_USER=entitysync
POSTGRES_PASSWORD=replace-me

# Required production structured-log export to the existing Logfire organization.
# Keep the write token in the deployment secret store; Logfire accepts OTLP over HTTP/protobuf only.
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://logfire-us.pydantic.dev/v1/logs
OTEL_EXPORTER_OTLP_HEADERS=Authorization=replace-with-logfire-write-token
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=lisstech-entitysync-mcp
SCHEDULER_OTEL_SERVICE_NAME=lisstech-entitysync-scheduler

# Set false to hold startup and recurring runs while retaining authenticated manual runs.
SCHEDULER_AUTOMATIC_RUNS_ENABLED=true

# Required bearer token for the scheduler's private POST /run endpoint. Use at least 32 non-whitespace characters.
SCHEDULER_RUN_TOKEN=

# Public HTTPS origin registered as the Entra web redirect URI. Dashboard sign-in
# reuses AGENTCONTROLLER_ENTRA_TENANT_ID, _CLIENT_ID, and _CLIENT_SECRET below.
DASHBOARD_PUBLIC_ORIGIN=https://scheduler.example.com

# All five vendors below are required by the scheduled full chain.
HALO_BASE_URL=
HALO_CLIENT_ID=
HALO_CLIENT_SECRET=
HALO_NCENTRAL_INTEGRATION_ID=
NETSUITE_ACCOUNT_ID=
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
NCENTRAL_BASE_URL=
NCENTRAL_USER_API_TOKEN=
NCENTRAL_SERVICE_ORG_ID=
NCENTRAL_SOAP_USERNAME=
NCENTRAL_SOAP_PASSWORD=
NCENTRAL_SOAP_ENDPOINT_PATH=
NCENTRAL_SOAP_NAMESPACE=
NCENTRAL_HALOPSA_ID_PROPERTY_LABEL=
NCENTRAL_NETSUITE_ID_PROPERTY_LABEL=
NCENTRAL_NETSUITE_NAME_PROPERTY_LABEL=
AGENTCONTROLLER_AUTH_BASE_URL=https://api-agent-controller.example.com
AGENTCONTROLLER_ENTRA_TENANT_ID=
AGENTCONTROLLER_ENTRA_CLIENT_ID=
AGENTCONTROLLER_ENTRA_CLIENT_SECRET=
AGENTCONTROLLER_ENTRA_SCOPE=api://agent-controller-application-id/.default
BILLCOM_API_TOKEN=
BILLCOM_BASE_URL=https://gateway.prod.bill.com/connect/v3/spend/custom-fields
BILLCOM_CLIENT_FIELD_NAME=Client
SOPHOS_CENTRAL_CLIENT_ID=
SOPHOS_CENTRAL_CLIENT_SECRET=
SOPHOS_CENTRAL_DEFAULT_DATA_GEOGRAPHY=
SOPHOS_CENTRAL_DEFAULT_DATA_REGION=
SOPHOS_CENTRAL_DEFAULT_BILLING_TYPE=
